{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "taskkill /F /IM gdb.exe 2>nul & c:\\mingw-w64\\bin\\g++.exe -fdiagnostics-color=always -g -std=c++23 ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false
            },
            "detail": "Kill stale GDB, then compile active C++ file with debug symbols"
        }
    ],
    "version": "2.0.0"
}